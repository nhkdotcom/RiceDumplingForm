<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - All Orders</title>
    <style>
        body {font-family: 'Segoe UI', sans-serif; margin:20px; background:#f8f9fa;}
        table {width:100%; border-collapse:collapse; margin-top:20px;}
        th, td {padding:12px; border:1px solid #ddd; text-align:left;}
        th {background:#d35400; color:white;}
        .header {background:#d35400; color:white; padding:15px; text-align:center; font-size:22px;}
    </style>
</head>
<body>
    <div class="header">All Orders - Admin Panel</div>
    <table id="ordersTable">
        <thead>
            <tr>
                <th>Date</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Collection Date</th>
                <th>Point</th>
                <th>Rendang Qty</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <script>
        const SUPABASE_URL = "https://gnfsbbnekmbgttrhmavu.supabase.co";
        const SUPABASE_ANON_KEY = "sb_publishable_FlPMHCir5_TOuROiv0DwNw_deMtyPI-";

        async function loadAllOrders() {
            try {
                const res = await fetch(`${SUPABASE_URL}/rest/v1/beef_rendang_orders?order=created_at.desc`, {
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`
                    }
                });
                const orders = await res.json();
                const tbody = document.querySelector('#ordersTable tbody');
                tbody.innerHTML = '';

                orders.forEach(order => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td>${new Date(order.created_at).toLocaleString()}</td>
                        <td>${order.name}</td>
                        <td>${order.phone}</td>
                        <td>${order.collection_date}</td>
                        <td>${order.collection_point}</td>
                        <td>${order.rendang_qty}</td>
                        <td>$${order.total_price}</td>
                    `;
                    tbody.appendChild(row);
                });
            } catch (e) {
                console.error(e);
            }
        }

        window.onload = loadAllOrders;
    </script>
</body>
</html>
